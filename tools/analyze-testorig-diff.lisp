(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(let* ((path "/home/arthur/repos/libjpeg-turbo/testimages/testorig.jpg")
       (dims (multiple-value-list (jpeg-file-dimensions path)))
       (h (first dims))
       (w (second dims))
       (buf-scalar (let ((*use-simd* :off)) (decode-image path)))
       (buf-inter  (let ((*use-simd* :on) (*upsample-impl* nil)) (decode-image path)))
       (buf-fused  (let ((*use-simd* :on) (*upsample-impl* #'planar-upsample)) (decode-image path))))
  (format t "testorig dimensions: ~D x ~D (total ~D pixels, ~D bytes)~%" w h (* w h) (length buf-inter))
  
  (format t "~%--- Diff analysis: Fused vs Interleaved ---~%")
  (let ((diff-count 0)
        (right-edge-count 0)
        (bottom-edge-count 0)
        (corner-count 0)
        (interior-count 0)
        (channel-diff-counts (make-array 3 :initial-element 0))
        (max-diff-val 0))
    (dotimes (y h)
      (dotimes (x w)
        (let* ((idx (* (+ (* y w) x) 3))
               (b-int (aref buf-inter idx))
               (g-int (aref buf-inter (+ idx 1)))
               (r-int (aref buf-inter (+ idx 2)))
               (b-fus (aref buf-fused idx))
               (g-fus (aref buf-fused (+ idx 1)))
               (r-fus (aref buf-fused (+ idx 2)))
               (db (abs (- b-int b-fus)))
               (dg (abs (- g-int g-fus)))
               (dr (abs (- r-int r-fus))))
          (when (> db 0) (incf (aref channel-diff-counts 0)) (setf max-diff-val (max max-diff-val db)))
          (when (> dg 0) (incf (aref channel-diff-counts 1)) (setf max-diff-val (max max-diff-val dg)))
          (when (> dr 0) (incf (aref channel-diff-counts 2)) (setf max-diff-val (max max-diff-val dr)))
          (when (or (> db 0) (> dg 0) (> dr 0))
            (incf diff-count)
            (cond
              ((and (= x (1- w)) (= y (1- h))) (incf corner-count))
              ((= x (1- w)) (incf right-edge-count))
              ((= y (1- h)) (incf bottom-edge-count))
              (t (incf interior-count)
                 (format t "Interior diff at (~D, ~D): Int=(~D,~D,~D) Fus=(~D,~D,~D)~%"
                         x y b-int g-int r-int b-fus g-fus r-fus)))))))
    (format t "Total pixel diffs: ~D~%" diff-count)
    (format t "Channel diff counts: B=~D, G=~D, R=~D (max abs diff = ~D LSB)~%"
            (aref channel-diff-counts 0)
            (aref channel-diff-counts 1)
            (aref channel-diff-counts 2)
            max-diff-val)
    (format t "Right edge only (x=~D): ~D~%" (1- w) right-edge-count)
    (format t "Bottom edge only (y=~D): ~D~%" (1- h) bottom-edge-count)
    (format t "Corner (bottom-right: x=~D, y=~D): ~D~%" (1- w) (1- h) corner-count)
    (format t "Interior diffs: ~D~%" interior-count)))
