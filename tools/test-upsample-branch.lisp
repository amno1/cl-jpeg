(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(let ((c-1x1 0)
      (c-2x2 0)
      (c-fb 0))
  (defun check-upsample (image scan block x y H V offset nwidth nw nx dend)
    (let* ((buffer (descriptor-buffer image))
           (xbase (+ (scan-x scan) x))
           (ybase (+ (scan-y scan) y))
           (img-w (descriptor-width image))
           (img-h (descriptor-height image))
           (ncomp (descriptor-ncomp image))
           (base-pos (+ (* ybase nwidth) (* xbase ncomp))))
      (cond
        ((and (= H 1) (= V 1) (= ncomp 3) (<= (+ xbase 8) img-w) (<= (+ ybase 8) img-h))
         (incf c-1x1))
        ((and (= H 2) (= V 2) (= ncomp 3) (<= (+ xbase 16) img-w) (<= (+ ybase 16) img-h))
         (incf c-2x2))
        (t
         (incf c-fb)))))

  (let* ((path "/tmp/photo3_1024x1024.jpg"))
    (with-open-file (stream path :direction :input :element-type 'uint8)
      (let* ((image (make-descriptor)))
        (setf (descriptor-byte-reader image) (lambda () (read-byte stream nil 0)))
        (read-marker image)
        (interpret-markers image 0)
        (decode-frame-beginning image nil)
        (loop for i fixnum from 0 below (descriptor-ncomp image)
              with hv fixnum do
              (setf (aref (descriptor-cid image) i) (read-jpeg-byte image))
              (setf hv (read-jpeg-byte image))
              (setf (aref (descriptor-H image) i) (ash hv -4))
              (setf (aref (descriptor-V image) i) (logand hv 7))
              (setf (aref (descriptor-qdest image) i) (read-jpeg-byte image)))
        (let* ((frl (loop for i fixnum from 0 below (descriptor-ncomp image)
                          collecting (list (aref (descriptor-H image) i)
                                           (aref (descriptor-V image) i))))
               (Hmax (loop for entry in frl maximize (first entry)))
               (Vmax (loop for entry in frl maximize (second entry)))
               (freqs (convert-sampling frl Hmax Vmax)))
          (loop for entry across freqs
                for i fixnum from 0 do
                (setf (aref (descriptor-iH image) i) (first entry))
                (setf (aref (descriptor-iV image) i) (second entry)))
          (interpret-markers image 0)
          (let ((mcus-x (ceiling (descriptor-width image) (* Hmax 8)))
                (mcus-y (ceiling (descriptor-height image) (* Vmax 8)))
                (scan (make-scan)))
            (setf (scan-x scan) 0 (scan-y scan) 0)
            (dotimes (my mcus-y)
              (dotimes (mx mcus-x)
                (dotimes (comp 3)
                  (let* ((H (first (aref freqs comp)))
                         (V (second (aref freqs comp)))
                         (bx-max (aref (descriptor-H image) comp))
                         (by-max (aref (descriptor-V image) comp)))
                    (dotimes (by by-max)
                      (dotimes (bx bx-max)
                        (let ((x-pos (* bx 8 H))
                              (y-pos (* by 8 V)))
                          (check-upsample image scan nil x-pos y-pos H V comp (* 1024 3) 0 0 0))))))
                (incf (scan-x scan) (* Hmax 8))
                (when (<= (descriptor-width image) (scan-x scan))
                  (incf (scan-y scan) (* Vmax 8))
                  (setf (scan-x scan) 0))))))))
    (format t "Fixed branches: 1x1=~:D, 2x2=~:D, fallback=~:D~%" c-1x1 c-2x2 c-fb)))

(sb-ext:exit :code 0)
