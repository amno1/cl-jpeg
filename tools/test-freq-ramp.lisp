(require :asdf)
(push "/home/arthur/repos/cl/cl-jpeg-avx512/" asdf:*central-registry*)
(asdf:load-system :cl-jpeg)

(in-package :cl-user)

(defun burn-cpu-for-seconds (seconds)
  (let ((stop (+ (get-internal-real-time) (* seconds internal-time-units-per-second)))
        (cnt 0))
    (declare (type fixnum cnt))
    (loop while (< (get-internal-real-time) stop) do
      (setf cnt (logand (1+ cnt) #x7fffffff)))))

(defun make-test-image (width height)
  (let* ((npixels (* width height))
         (buf (make-array (* npixels 3) :element-type '(unsigned-byte 8))))
    (dotimes (y height)
      (dotimes (x width)
        (let ((idx (* (+ (* y width) x) 3)))
          (setf (aref buf idx) (mod x 256)
                (aref buf (+ idx 1)) (mod y 256)
                (aref buf (+ idx 2)) (mod (+ x y) 256)))))
    buf))

(let* ((width 2048) (height 2048)
       (img (make-test-image width height))
       (out-stream (make-broadcast-stream)))
  (format t "Warming up and burning CPU for 3 seconds to reach max boost clock...~%")
  (burn-cpu-for-seconds 3)
  ;; Warmup encode runs
  (dotimes (i 10)
    (jpeg:encode-image-stream out-stream img 3 height width :sampling '((2 2) (1 1) (1 1))))

  ;; Measure Mode OFF (scalar)
  (setf jpeg:*use-simd* :off)
  (format t "~%Measuring Mode OFF (scalar, 20 reps)...~%")
  (let ((scalar-times nil))
    (dotimes (r 20)
      (let ((t0 (get-internal-real-time)))
        (jpeg:encode-image-stream out-stream img 3 height width :sampling '((2 2) (1 1) (1 1)))
        (let* ((t1 (get-internal-real-time))
               (dt (/ (- t1 t0) (float internal-time-units-per-second))))
          (push dt scalar-times)
          (format t " ~5,1f" (* dt 1000.0)))))
    (terpri)
    (let* ((mean (/ (reduce #'+ scalar-times) 20))
           (std (sqrt (/ (reduce #'+ (mapcar (lambda (x) (expt (- x mean) 2)) scalar-times)) 20))))
      (format t "Scalar Mean: ~,2f ms +/- ~,2f ms  |  ~,1f MPix/s~%"
              (* mean 1000.0) (* std 1000.0) (/ (* width height) mean 1000000.0))))

  ;; Measure Mode AUTO (SIMD)
  (setf jpeg:*use-simd* :auto)
  (format t "~%Measuring Mode AUTO (SIMD, 20 reps)...~%")
  (let ((simd-times nil))
    (dotimes (r 20)
      (let ((t0 (get-internal-real-time)))
        (jpeg:encode-image-stream out-stream img 3 height width :sampling '((2 2) (1 1) (1 1)))
        (let* ((t1 (get-internal-real-time))
               (dt (/ (- t1 t0) (float internal-time-units-per-second))))
          (push dt simd-times)
          (format t " ~5,1f" (* dt 1000.0)))))
    (terpri)
    (let* ((mean (/ (reduce #'+ simd-times) 20))
           (std (sqrt (/ (reduce #'+ (mapcar (lambda (x) (expt (- x mean) 2)) simd-times)) 20))))
      (format t "SIMD Mean:   ~,2f ms +/- ~,2f ms  |  ~,1f MPix/s~%"
              (* mean 1000.0) (* std 1000.0) (/ (* width height) mean 1000000.0)))))

(sb-ext:exit)
