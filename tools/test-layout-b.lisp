(macrolet ((transpose-8x8 (r0 r1 r2 r3 r4 r5 r6 r7)
             `(let* ((s0 (s32.8-unpacklo ,r0 ,r1))
                     (s1 (s32.8-unpackhi ,r0 ,r1))
                     (s2 (s32.8-unpacklo ,r2 ,r3))
                     (s3 (s32.8-unpackhi ,r2 ,r3))
                     (s4 (s32.8-unpacklo ,r4 ,r5))
                     (s5 (s32.8-unpackhi ,r4 ,r5))
                     (s6 (s32.8-unpacklo ,r6 ,r7))
                     (s7 (s32.8-unpackhi ,r6 ,r7))
                     (t0 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s0) (sb-simd-avx2:s64.4! s2))))
                     (t1 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s0) (sb-simd-avx2:s64.4! s2))))
                     (t2 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s1) (sb-simd-avx2:s64.4! s3))))
                     (t3 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s1) (sb-simd-avx2:s64.4! s3))))
                     (t4 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s4) (sb-simd-avx2:s64.4! s6))))
                     (t5 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s4) (sb-simd-avx2:s64.4! s6))))
                     (t6 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s5) (sb-simd-avx2:s64.4! s7))))
                     (t7 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s5) (sb-simd-avx2:s64.4! s7)))))
                (values
                 (s32.8-permute128 t0 t4 #x20)
                 (s32.8-permute128 t1 t5 #x20)
                 (s32.8-permute128 t2 t6 #x20)
                 (s32.8-permute128 t3 t7 #x20)
                 (s32.8-permute128 t0 t4 #x31)
                 (s32.8-permute128 t1 t5 #x31)
                 (s32.8-permute128 t2 t6 #x31)
                 (s32.8-permute128 t3 t7 #x31))))
           (vert-dct-p1 (c0 c1 c2 c3 c4 c5 c6 c7)
             `(let* ((tmp0 (s32.8+ ,c0 ,c7))
                     (tmp7 (s32.8- ,c0 ,c7))
                     (tmp1 (s32.8+ ,c1 ,c6))
                     (tmp6 (s32.8- ,c1 ,c6))
                     (tmp2 (s32.8+ ,c2 ,c5))
                     (tmp5 (s32.8- ,c2 ,c5))
                     (tmp3 (s32.8+ ,c3 ,c4))
                     (tmp4 (s32.8- ,c3 ,c4))
                     (tmp10 (s32.8+ tmp0 tmp3))
                     (tmp13 (s32.8- tmp0 tmp3))
                     (tmp11 (s32.8+ tmp1 tmp2))
                     (tmp12 (s32.8- tmp1 tmp2))
                     (out0 (s32.8-shiftl (s32.8+ tmp10 tmp11) 1))
                     (out4 (s32.8-shiftl (s32.8- tmp10 tmp11) 1))
                     (z1 (s32.8-mullo (s32.8+ tmp12 tmp13) (s32.8 ,+FIX-0-541196100+)))
                     (out2 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp13 (s32.8 ,+FIX-0-765366865+)) (s32.8 2048)) 12))
                     (out6 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp12 (s32.8 ,(- +FIX-1-847759065+))) (s32.8 2048)) 12))
                     (z1-odd (s32.8+ tmp4 tmp7))
                     (z2 (s32.8+ tmp5 tmp6))
                     (z3 (s32.8+ tmp4 tmp6))
                     (z4 (s32.8+ tmp5 tmp7))
                     (z5 (s32.8-mullo (s32.8+ z3 z4) (s32.8 ,+FIX-1-175875602+)))
                     (m4 (s32.8-mullo tmp4 (s32.8 ,+FIX-0-298631336+)))
                     (m5 (s32.8-mullo tmp5 (s32.8 ,+FIX-2-053119869+)))
                     (m6 (s32.8-mullo tmp6 (s32.8 ,+FIX-3-072711026+)))
                     (m7 (s32.8-mullo tmp7 (s32.8 ,+FIX-1-501321110+)))
                     (z1-odd-m (s32.8-mullo z1-odd (s32.8 ,(- +FIX-0-899976223+))))
                     (z2-m (s32.8-mullo z2 (s32.8 ,(- +FIX-2-562915447+))))
                     (z3-m (s32.8+ (s32.8-mullo z3 (s32.8 ,(- +FIX-1-961570560+))) z5))
                     (z4-m (s32.8+ (s32.8-mullo z4 (s32.8 ,(- +FIX-0-390180644+))) z5))
                     (bias (s32.8 2048))
                     (out7 (s32.8-shiftr (s32.8+ m4 z1-odd-m z3-m bias) 12))
                     (out5 (s32.8-shiftr (s32.8+ m5 z2-m z4-m bias) 12))
                     (out3 (s32.8-shiftr (s32.8+ m6 z2-m z3-m bias) 12))
                     (out1 (s32.8-shiftr (s32.8+ m7 z1-odd-m z4-m bias) 12)))
                (values out0 out1 out2 out3 out4 out5 out6 out7)))
           (vert-dct-p2 (c0 c1 c2 c3 c4 c5 c6 c7)
             `(let* ((tmp0 (s32.8+ ,c0 ,c7))
                     (tmp7 (s32.8- ,c0 ,c7))
                     (tmp1 (s32.8+ ,c1 ,c6))
                     (tmp6 (s32.8- ,c1 ,c6))
                     (tmp2 (s32.8+ ,c2 ,c5))
                     (tmp5 (s32.8- ,c2 ,c5))
                     (tmp3 (s32.8+ ,c3 ,c4))
                     (tmp4 (s32.8- ,c3 ,c4))
                     (tmp10 (s32.8+ tmp0 tmp3))
                     (tmp13 (s32.8- tmp0 tmp3))
                     (tmp11 (s32.8+ tmp1 tmp2))
                     (tmp12 (s32.8- tmp1 tmp2))
                     (out0 (s32.8-shiftr (s32.8+ tmp10 tmp11 (s32.8 1)) 1))
                     (out4 (s32.8-shiftr (s32.8+ (s32.8- tmp10 tmp11) (s32.8 1)) 1))
                     (z1 (s32.8-mullo (s32.8+ tmp12 tmp13) (s32.8 ,+FIX-0-541196100+)))
                     (out2 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp13 (s32.8 ,+FIX-0-765366865+)) (s32.8 8192)) 14))
                     (out6 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp12 (s32.8 ,(- +FIX-1-847759065+))) (s32.8 8192)) 14))
                     (z1-odd (s32.8+ tmp4 tmp7))
                     (z2 (s32.8+ tmp5 tmp6))
                     (z3 (s32.8+ tmp4 tmp6))
                     (z4 (s32.8+ tmp5 tmp7))
                     (z5 (s32.8-mullo (s32.8+ z3 z4) (s32.8 ,+FIX-1-175875602+)))
                     (m4 (s32.8-mullo tmp4 (s32.8 ,+FIX-0-298631336+)))
                     (m5 (s32.8-mullo tmp5 (s32.8 ,+FIX-2-053119869+)))
                     (m6 (s32.8-mullo tmp6 (s32.8 ,+FIX-3-072711026+)))
                     (m7 (s32.8-mullo tmp7 (s32.8 ,+FIX-1-501321110+)))
                     (z1-odd-m (s32.8-mullo z1-odd (s32.8 ,(- +FIX-0-899976223+))))
                     (z2-m (s32.8-mullo z2 (s32.8 ,(- +FIX-2-562915447+))))
                     (z3-m (s32.8+ (s32.8-mullo z3 (s32.8 ,(- +FIX-1-961570560+))) z5))
                     (z4-m (s32.8+ (s32.8-mullo z4 (s32.8 ,(- +FIX-0-390180644+))) z5))
                     (bias (s32.8 8192))
                     (out7 (s32.8-shiftr (s32.8+ m4 z1-odd-m z3-m bias) 14))
                     (out5 (s32.8-shiftr (s32.8+ m5 z2-m z4-m bias) 14))
                     (out3 (s32.8-shiftr (s32.8+ m6 z2-m z3-m bias) 14))
                     (out1 (s32.8-shiftr (s32.8+ m7 z1-odd-m z4-m bias) 14)))
                (values out0 out1 out2 out3 out4 out5 out6 out7))))

  (defun simd-dct-block-layout-b (buf b nblocks)
    (declare #.*optimize*
             (type (simple-array sint16 (*)) buf)
             (type fixnum b nblocks))
    (let* ((stride (the fixnum (ash nblocks 3)))
           (b_base (the fixnum (ash b 3)))
           ;; 1. Load rows into s32.8
           (r0 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 0 stride)))))
           (r1 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 1 stride)))))
           (r2 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 2 stride)))))
           (r3 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 3 stride)))))
           (r4 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 4 stride)))))
           (r5 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 5 stride)))))
           (r6 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 6 stride)))))
           (r7 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf (+ b_base (* 7 stride))))))
      ;; 2. Transpose so rows become columns
      (multiple-value-bind (t0 t1 t2 t3 t4 t5 t6 t7)
          (transpose-8x8 r0 r1 r2 r3 r4 r5 r6 r7)
        ;; 3. Pass 1: 1D DCT on rows (now vertical in t0..t7)
        (multiple-value-bind (p0 p1 p2 p3 p4 p5 p6 p7)
            (vert-dct-p1 t0 t1 t2 t3 t4 t5 t6 t7)
          ;; 4. Transpose so columns become rows
          (multiple-value-bind (c0 c1 c2 c3 c4 c5 c6 c7)
              (transpose-8x8 p0 p1 p2 p3 p4 p5 p6 p7)
            ;; 5. Pass 2: 1D DCT on columns (vertical in c0..c7)
            (multiple-value-bind (f0 f1 f2 f3 f4 f5 f6 f7)
                (vert-dct-p2 c0 c1 c2 c3 c4 c5 c6 c7)
              ;; 6. Pack pairs of rows and store
              (let* ((p01 (s16.16! (f64.4-permute4x64 (f64.4! (s16.16-packs f0 f1)) #xD8)))
                     (p23 (s16.16! (f64.4-permute4x64 (f64.4! (s16.16-packs f2 f3)) #xD8)))
                     (p45 (s16.16! (f64.4-permute4x64 (f64.4! (s16.16-packs f4 f5)) #xD8)))
                     (p67 (s16.16! (f64.4-permute4x64 (f64.4! (s16.16-packs f6 f7)) #xD8))))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 0 stride))) (s16.8-from-s16.16 p01 0))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 1 stride))) (s16.8-from-s16.16 p01 1))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 2 stride))) (s16.8-from-s16.16 p23 0))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 3 stride))) (s16.8-from-s16.16 p23 1))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 4 stride))) (s16.8-from-s16.16 p45 0))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 5 stride))) (s16.8-from-s16.16 p45 1))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 6 stride))) (s16.8-from-s16.16 p67 0))
                (setf (sb-simd-sse2:s16.8-aref buf (+ b_base (* 7 stride))) (s16.8-from-s16.16 p67 1))))))))))

(defun test-correctness (&key (nblocks 1024))
  (let* ((stride (* nblocks 8))
         (buf1 (make-array (* nblocks 64) :element-type 'sint16))
         (buf2 (make-array (* nblocks 64) :element-type 'sint16)))
    (declare (type (simple-array sint16 (*)) buf1 buf2))
    ;; Initialize test data with typical JPEG level-shifted sample ranges [-128, 127]
    (dotimes (i (* nblocks 64))
      (let ((v (- (mod (* (1+ i) 1664525) 256) 128)))
        (setf (aref buf1 i) v
              (aref buf2 i) v)))
    ;; Run scalar
    (dotimes (b nblocks)
      (llm-dct buf1 b nblocks))
    ;; Run Layout B
    (dotimes (b nblocks)
      (simd-dct-block-layout-b buf2 b nblocks))
    ;; Compare
    (let ((diffs 0) (max-diff 0))
      (dotimes (i (* nblocks 64))
        (let ((d (abs (- (aref buf1 i) (aref buf2 i)))))
          (when (> d 0)
            (incf diffs)
            (setf max-diff (max max-diff d)))))
      (format t "Correctness Check on ~d blocks: diffs: ~d / ~d (max delta: ~d)~%"
              nblocks diffs (* nblocks 64) max-diff)
      (if (zerop diffs)
          (format t ">>> SUCCESS: 100% BYTE-EXACT MATCH WITH SCALAR LLM-DCT! <<<~%")
          (format t ">>> FAILURE: Mismatch found! <<<~%")))))

(defun bench-layout-b (&key (nblocks 65536) (reps 5))
  (let ((buf (make-array (* nblocks 64) :element-type 'sint16 :initial-element 100)))
    (declare (type (simple-array sint16 (*)) buf))
    (format t "Benchmarking Layout B on ~d blocks (~,2f MPix)...~%" nblocks (/ (* nblocks 64) 1000000.0))
    ;; Warmup
    (loop for b fixnum from 0 below 1024 do
      (simd-dct-block-layout-b buf b nblocks))
    (let ((times nil))
      (dotimes (r reps)
        (let ((t0 (get-internal-real-time)))
          (loop for b fixnum from 0 below nblocks do
            (simd-dct-block-layout-b buf b nblocks))
          (let* ((t1 (get-internal-real-time))
                 (dt (/ (- t1 t0) (float internal-time-units-per-second))))
            (push dt times)
            (format t "  Rep ~2d: ~,2f ms | ~,1f MPix/s | ~,1f ns/block~%"
                    r (* dt 1000.0) (/ (* nblocks 64) dt 1000000.0) (/ (* dt 1000000000.0) nblocks)))))
      (let* ((mean (/ (reduce #'+ times) (length times)))
             (variance (/ (reduce #'+ (mapcar (lambda (x) (expt (- x mean) 2)) times)) (length times)))
             (std (sqrt variance)))
        (format t "SUMMARY Layout B: Mean: ~,2f ms +/- ~,2f ms | ~,1f MPix/s | ~,1f ns/block~%"
                (* mean 1000.0) (* std 1000.0) (/ (* nblocks 64) mean 1000000.0) (/ (* mean 1000000000.0) nblocks))))))
