(require :sb-simd)

(defun test-1d-dct ()
  ;; Test vertical 1D DCT on 8 columns
  (let* ((in (make-array '(8 8) :element-type '(signed-byte 16)))
         (scalar-out (make-array '(8 8) :element-type '(signed-byte 16))))
    ;; Fill with test data
    (dotimes (r 8)
      (dotimes (c 8)
        (setf (aref in r c) (- (* (+ r 1) (+ c 2) 7) 128))))
    ;; Run scalar pass 1 on each row
    (dotimes (r 8)
      (let* ((d0 (aref in r 0)) (d1 (aref in r 1))
             (d2 (aref in r 2)) (d3 (aref in r 3))
             (d4 (aref in r 4)) (d5 (aref in r 5))
             (d6 (aref in r 6)) (d7 (aref in r 7))
             (tmp0 (+ d0 d7)) (tmp7 (- d0 d7))
             (tmp1 (+ d1 d6)) (tmp6 (- d1 d6))
             (tmp2 (+ d2 d5)) (tmp5 (- d2 d5))
             (tmp3 (+ d3 d4)) (tmp4 (- d3 d4))
             (tmp10 (+ tmp0 tmp3)) (tmp13 (- tmp0 tmp3))
             (tmp11 (+ tmp1 tmp2)) (tmp12 (- tmp1 tmp2))
             (z1 (* (+ tmp12 tmp13) 4433))
             (out0 (ash (+ tmp10 tmp11) 1))
             (out4 (ash (- tmp10 tmp11) 1))
             (out2 (ash (+ (+ z1 (* tmp13 6270)) 2048) -12))
             (out6 (ash (+ (+ z1 (* tmp12 -15137)) 2048) -12))
             (z1_odd (+ tmp4 tmp7))
             (z2 (+ tmp5 tmp6))
             (z3 (+ tmp4 tmp6))
             (z4 (+ tmp5 tmp7))
             (z5 (* (+ z3 z4) 9633))
             (m4 (* tmp4 2446))
             (m5 (* tmp5 16819))
             (m6 (* tmp6 25172))
             (m7 (* tmp7 12299))
             (z1_odd_m (* z1_odd -7373))
             (z2_m (* z2 -20995))
             (z3_m (+ (* z3 -16069) z5))
             (z4_m (+ (* z4 -3196) z5))
             (out7 (ash (+ (+ m4 z1_odd_m z3_m) 2048) -12))
             (out5 (ash (+ (+ m5 z2_m z4_m) 2048) -12))
             (out3 (ash (+ (+ m6 z2_m z3_m) 2048) -12))
             (out1 (ash (+ (+ m7 z1_odd_m z4_m) 2048) -12)))
        (setf (aref scalar-out r 0) out0)
        (setf (aref scalar-out r 1) out1)
        (setf (aref scalar-out r 2) out2)
        (setf (aref scalar-out r 3) out3)
        (setf (aref scalar-out r 4) out4)
        (setf (aref scalar-out r 5) out5)
        (setf (aref scalar-out r 6) out6)
        (setf (aref scalar-out r 7) out7)))
    (format t "Scalar row 0: ~a~%" (loop for c below 8 collect (aref scalar-out 0 c)))))

(test-1d-dct)
(sb-ext:exit)
