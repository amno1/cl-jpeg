(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(defun measure-decode-time (path &key (n-reps 20) (idct-mode :scalar))
  ;; idct-mode can be :scalar, :simd, :stub
  (let ((jpeg:*use-simd* :on)
        (jpeg::*inverse-colorspace-convert-impl* nil)) ; keep color conversion constant (scalar)
    (case idct-mode
      (:scalar (setf jpeg::*inverse-llm-dct-impl* #'jpeg::inverse-llm-dct-scalar))
      (:simd   (setf jpeg::*inverse-llm-dct-impl* #'jpeg::inverse-llm-dct-simd))
      (:stub   (setf jpeg::*inverse-llm-dct-impl* (lambda (b q w) (declare (ignore b q w)) (values)))))
    ;; Warmup
    (dotimes (i 5) (decode-image path))
    ;; Measure best batch
    (let ((best-ms 1e9))
      (dotimes (batch 5)
        (sb-ext:gc :full t)
        (let ((t0 (get-internal-real-time)))
          (dotimes (r n-reps)
            (decode-image path))
          (let* ((t1 (get-internal-real-time))
                 (ms (* (/ (- t1 t0) (float internal-time-units-per-second)) (/ 1000.0 n-reps))))
            (when (< ms best-ms)
              (setf best-ms ms)))))
      best-ms)))

(defun test-image-idct-ablation (path label)
  (let* ((t-scalar (measure-decode-time path :n-reps 20 :idct-mode :scalar))
         (t-simd   (measure-decode-time path :n-reps 20 :idct-mode :simd))
         (t-stub   (measure-decode-time path :n-reps 20 :idct-mode :stub))
         (scalar-idct-ms (- t-scalar t-stub))
         (simd-idct-ms   (- t-simd t-stub))
         (idct-frac (* 100.0 (/ scalar-idct-ms t-scalar)))
         (kernel-speedup (if (> simd-idct-ms 0.001) (/ scalar-idct-ms simd-idct-ms) 0.0))
         (e2e-speedup (/ t-scalar t-simd)))
    (format t "~%=== ~A (~A) ===~%" label path)
    (format t "  Total Decode (Scalar IDCT): ~6,2F ms~%" t-scalar)
    (format t "  Total Decode (SIMD IDCT):   ~6,2F ms~%" t-simd)
    (format t "  Total Decode (Stubbed IDCT):~6,2F ms~%" t-stub)
    (format t "  ---------------------------------------------~%")
    (format t "  True Scalar IDCT Time:      ~6,2F ms (~4,1F% of total decode)~%" scalar-idct-ms idct-frac)
    (format t "  True SIMD IDCT Time:        ~6,2F ms~%" simd-idct-ms)
    (format t "  True In-Situ Kernel Speedup: ~5,2Fx~%" kernel-speedup)
    (format t "  End-to-End Speedup (IDCT):   ~5,2Fx~%" e2e-speedup)))

(test-image-idct-ablation "/tmp/photo1_512x512.jpg" "photo1 (512x512)")
(test-image-idct-ablation "/tmp/photo3_1024x1024.jpg" "photo3 (1024x1024)")
(test-image-idct-ablation "/home/arthur/repos/libjpeg-turbo/testimages/testorig.jpg" "testorig (227x149)")
(test-image-idct-ablation "/tmp/cl-jpeg-bench-512x512.jpg" "gradient (512x512)")

(sb-ext:exit :code 0)
