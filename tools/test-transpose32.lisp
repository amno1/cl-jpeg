(require :sb-simd)
(in-package :cl-user)
(use-package :sb-simd-avx2)

(defun test-transpose-32 ()
  (let* ((rows (make-array 8)))
    ;; Row r has [r*10+0, r*10+1, ..., r*10+7]
    (dotimes (r 8)
      (setf (aref rows r)
            (make-s32.8 (+ (* r 10) 0) (+ (* r 10) 1) (+ (* r 10) 2) (+ (* r 10) 3)
                        (+ (* r 10) 4) (+ (* r 10) 5) (+ (* r 10) 6) (+ (* r 10) 7))))
    (let* ((r0 (aref rows 0)) (r1 (aref rows 1))
           (r2 (aref rows 2)) (r3 (aref rows 3))
           (r4 (aref rows 4)) (r5 (aref rows 5))
           (r6 (aref rows 6)) (r7 (aref rows 7))
           ;; Phase 1: 32-bit unpack
           (s0 (s32.8-unpacklo r0 r1))
           (s1 (s32.8-unpackhi r0 r1))
           (s2 (s32.8-unpacklo r2 r3))
           (s3 (s32.8-unpackhi r2 r3))
           (s4 (s32.8-unpacklo r4 r5))
           (s5 (s32.8-unpackhi r4 r5))
           (s6 (s32.8-unpacklo r6 r7))
           (s7 (s32.8-unpackhi r6 r7))
           ;; Phase 2: 64-bit unpack
           (t0 (s32.8! (s64.4-unpacklo (s64.4! s0) (s64.4! s2))))
           (t1 (s32.8! (s64.4-unpackhi (s64.4! s0) (s64.4! s2))))
           (t2 (s32.8! (s64.4-unpacklo (s64.4! s1) (s64.4! s3))))
           (t3 (s32.8! (s64.4-unpackhi (s64.4! s1) (s64.4! s3))))
           (t4 (s32.8! (s64.4-unpacklo (s64.4! s4) (s64.4! s6))))
           (t5 (s32.8! (s64.4-unpackhi (s64.4! s4) (s64.4! s6))))
           (t6 (s32.8! (s64.4-unpacklo (s64.4! s5) (s64.4! s7))))
           (t7 (s32.8! (s64.4-unpackhi (s64.4! s5) (s64.4! s7))))
           ;; Phase 3: 128-bit lane permute (vperm2i128)
           (c0 (s32.8-permute128 t0 t4 #x20))
           (c4 (s32.8-permute128 t0 t4 #x31))
           (c1 (s32.8-permute128 t1 t5 #x20))
           (c5 (s32.8-permute128 t1 t5 #x31))
           (c2 (s32.8-permute128 t2 t6 #x20))
           (c6 (s32.8-permute128 t2 t6 #x31))
           (c3 (s32.8-permute128 t3 t7 #x20))
           (c7 (s32.8-permute128 t3 t7 #x31)))
      (format t "Col 0: ~a~%" c0)
      (format t "Col 1: ~a~%" c1)
      (format t "Col 4: ~a~%" c4)
      (format t "Col 7: ~a~%" c7))))

(test-transpose-32)
(sb-ext:exit)
