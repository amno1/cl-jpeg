(require :sb-simd)

(defun test-transpose ()
  (let* ((rows (make-array 8))
         (out (make-array 64 :element-type '(signed-byte 16))))
    (declare (type (simple-array (signed-byte 16) (64)) out))
    ;; Initialize 8 rows: row r has (r*10 + c) for c in 0..7
    (dotimes (r 8)
      (let ((arr (make-array 8 :element-type '(signed-byte 16))))
        (dotimes (c 8)
          (setf (aref arr c) (+ (* r 10) c)))
        (setf (aref rows r) (sb-simd-sse2:s16.8-aref arr 0))))

    (let* ((r0 (aref rows 0)) (r1 (aref rows 1))
           (r2 (aref rows 2)) (r3 (aref rows 3))
           (r4 (aref rows 4)) (r5 (aref rows 5))
           (r6 (aref rows 6)) (r7 (aref rows 7))
           ;; Phase 1: 16-bit unpack
           (t0 (sb-simd-sse2:s16.8-unpacklo r0 r1))
           (t1 (sb-simd-sse2:s16.8-unpackhi r0 r1))
           (t2 (sb-simd-sse2:s16.8-unpacklo r2 r3))
           (t3 (sb-simd-sse2:s16.8-unpackhi r2 r3))
           (t4 (sb-simd-sse2:s16.8-unpacklo r4 r5))
           (t5 (sb-simd-sse2:s16.8-unpackhi r4 r5))
           (t6 (sb-simd-sse2:s16.8-unpacklo r6 r7))
           (t7 (sb-simd-sse2:s16.8-unpackhi r6 r7))
           ;; Phase 2: 32-bit unpack
           (u0 (sb-simd-sse2:s32.4-unpacklo (sb-simd-sse2:s32.4! t0) (sb-simd-sse2:s32.4! t2)))
           (u1 (sb-simd-sse2:s32.4-unpackhi (sb-simd-sse2:s32.4! t0) (sb-simd-sse2:s32.4! t2)))
           (u2 (sb-simd-sse2:s32.4-unpacklo (sb-simd-sse2:s32.4! t1) (sb-simd-sse2:s32.4! t3)))
           (u3 (sb-simd-sse2:s32.4-unpackhi (sb-simd-sse2:s32.4! t1) (sb-simd-sse2:s32.4! t3)))
           (u4 (sb-simd-sse2:s32.4-unpacklo (sb-simd-sse2:s32.4! t4) (sb-simd-sse2:s32.4! t6)))
           (u5 (sb-simd-sse2:s32.4-unpackhi (sb-simd-sse2:s32.4! t4) (sb-simd-sse2:s32.4! t6)))
           (u6 (sb-simd-sse2:s32.4-unpacklo (sb-simd-sse2:s32.4! t5) (sb-simd-sse2:s32.4! t7)))
           (u7 (sb-simd-sse2:s32.4-unpackhi (sb-simd-sse2:s32.4! t5) (sb-simd-sse2:s32.4! t7)))
           ;; Phase 3: 64-bit unpack
           (c0 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpacklo (sb-simd-sse2:s64.2! u0) (sb-simd-sse2:s64.2! u4))))
           (c1 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpackhi (sb-simd-sse2:s64.2! u0) (sb-simd-sse2:s64.2! u4))))
           (c2 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpacklo (sb-simd-sse2:s64.2! u1) (sb-simd-sse2:s64.2! u5))))
           (c3 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpackhi (sb-simd-sse2:s64.2! u1) (sb-simd-sse2:s64.2! u5))))
           (c4 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpacklo (sb-simd-sse2:s64.2! u2) (sb-simd-sse2:s64.2! u6))))
           (c5 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpackhi (sb-simd-sse2:s64.2! u2) (sb-simd-sse2:s64.2! u6))))
           (c6 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpacklo (sb-simd-sse2:s64.2! u3) (sb-simd-sse2:s64.2! u7))))
           (c7 (sb-simd-sse2:s16.8! (sb-simd-sse2:s64.2-unpackhi (sb-simd-sse2:s64.2! u3) (sb-simd-sse2:s64.2! u7)))))
      (format t "Col 0: ~a~%" c0)
      (format t "Col 1: ~a~%" c1)
      (format t "Col 7: ~a~%" c7))))

(test-transpose)
(sb-ext:exit)
