(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(let* ((path "/home/arthur/repos/libjpeg-turbo/testimages/testorig.jpg")
       (w 227) (h 149)
       (buf-scalar (let ((*use-simd* :off)) (decode-image path)))
       (buf-inter  (let ((*use-simd* :on) (*upsample-impl* nil)) (decode-image path)))
       (buf-fused  (let ((*use-simd* :on) (*upsample-impl* #'planar-upsample)) (decode-image path))))
  
  (format t "Comparing the 64 divergence pixels across all 3 decoders:~%")
  (let ((scalar-matches-fused 0)
        (scalar-matches-inter 0)
        (other 0))
    (dotimes (y h)
      (dotimes (x w)
        (let* ((idx (* (+ (* y w) x) 3))
               (gi (aref buf-inter (+ idx 1)))
               (gf (aref buf-fused (+ idx 1)))
               (gs (aref buf-scalar (+ idx 1))))
          (when (/= gi gf)
            (cond
              ((= gs gf) (incf scalar-matches-fused))
              ((= gs gi) (incf scalar-matches-inter))
              (t (incf other)))))))
    (format t "Of the 64 differing pixels:~%")
    (format t "  Scalar matches Fused Planar:     ~D / 64~%" scalar-matches-fused)
    (format t "  Scalar matches Interleaved SIMD: ~D / 64~%" scalar-matches-inter)
    (format t "  Neither:                         ~D / 64~%" other)))
