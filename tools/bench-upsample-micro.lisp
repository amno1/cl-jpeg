(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(let* ((w 1024)
       (h 1024)
       (ncomp 3)
       (nwidth (* w ncomp))
       (buffer (make-array (* w h ncomp) :element-type 'uint8 :initial-element 0))
       (block (2d-sint16-array
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)
               '(128 128 128 128 128 128 128 128)))
       (n-trials 100000))
  (format t "Benchmarking upsample-1x1-fast (~:D calls)...~%" n-trials)
  (let ((t0 (get-internal-real-time)))
    (dotimes (i n-trials)
      (upsample-1x1-fast buffer block 0 0 nwidth))
    (let ((dt (/ (- (get-internal-real-time) t0) (float internal-time-units-per-second))))
      (format t "  1x1-fast: ~,2F ms total, ~,2F ns/call~%" (* dt 1000.0) (/ (* dt 1e9) n-trials))))

  (format t "Benchmarking upsample-2x2-fast (~:D calls)...~%" n-trials)
  (let ((t0 (get-internal-real-time)))
    (dotimes (i n-trials)
      (upsample-2x2-fast buffer block 0 0 nwidth))
    (let ((dt (/ (- (get-internal-real-time) t0) (float internal-time-units-per-second))))
      (format t "  2x2-fast: ~,2F ms total, ~,2F ns/call~%" (* dt 1000.0) (/ (* dt 1e9) n-trials)))))

(sb-ext:exit :code 0)
