(require :asdf)
(push "/home/arthur/repos/cl/cl-jpeg-avx512/" asdf:*central-registry*)
(asdf:load-system :cl-jpeg)

(in-package :cl-user)

(defun make-test-image (width height type)
  (let* ((npixels (* width height))
         (buf (make-array (* npixels 3) :element-type '(unsigned-byte 8))))
    (declare (type (simple-array (unsigned-byte 8) (*)) buf)
             (type fixnum width height npixels))
    (ecase type
      (:gradient
       (dotimes (y height)
         (dotimes (x width)
           (let ((idx (* (+ (* y width) x) 3)))
             (setf (aref buf idx) (mod x 256)
                   (aref buf (+ idx 1)) (mod y 256)
                   (aref buf (+ idx 2)) (mod (+ x y) 256))))))
      (:moire
       (dotimes (y height)
         (dotimes (x width)
           (let* ((idx (* (+ (* y width) x) 3))
                  (r (mod (+ (ash (* x x) -5) (ash (* y y) -5)) 256))
                  (g (mod (+ (* x 7) (* y 13)) 256))
                  (b (mod (logxor x y) 256)))
             (setf (aref buf idx) r
                   (aref buf (+ idx 1)) g
                   (aref buf (+ idx 2)) b))))))
    buf))

(defun run-bench (name image width height &key (reps 20))
  (let* ((npixels (* width height))
         (out-stream (make-broadcast-stream)))
    ;; 1. Measure SCALAR (*use-simd* :off)
    (setf jpeg:*use-simd* :off)
    (dotimes (i 3)
      (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1))))
    (let ((scalar-times nil))
      (dotimes (r reps)
        (let ((t0 (get-internal-real-time)))
          (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1)))
          (let* ((t1 (get-internal-real-time))
                 (dt (/ (- t1 t0) (float internal-time-units-per-second))))
            (push dt scalar-times))))
      (let* ((s-mean (/ (reduce #'+ scalar-times) (length scalar-times)))
             (s-std (sqrt (/ (reduce #'+ (mapcar (lambda (x) (expt (- x s-mean) 2)) scalar-times)) (length scalar-times))))
             (s-mpix (/ npixels s-mean 1000000.0)))

        ;; 2. Measure SIMD (*use-simd* :auto)
        (setf jpeg:*use-simd* :auto)
        (dotimes (i 3)
          (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1))))
        (let ((simd-times nil))
          (dotimes (r reps)
            (let ((t0 (get-internal-real-time)))
              (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1)))
              (let* ((t1 (get-internal-real-time))
                     (dt (/ (- t1 t0) (float internal-time-units-per-second))))
                (push dt simd-times))))
          (let* ((m-mean (/ (reduce #'+ simd-times) (length simd-times)))
                 (m-std (sqrt (/ (reduce #'+ (mapcar (lambda (x) (expt (- x m-mean) 2)) simd-times)) (length simd-times))))
                 (m-mpix (/ npixels m-mean 1000000.0))
                 (speedup (/ s-mean m-mean)))
            (format t "--------------------------------------------------------------------~%")
            (format t "  TEST: ~A (2048x2048, ~D reps)~%" name reps)
            (format t "    Scalar Baseline : ~,2f ms +/- ~,2f ms  |  ~,1f MPix/s~%" (* s-mean 1000.0) (* s-std 1000.0) s-mpix)
            (format t "    AVX2 SIMD DCT   : ~,2f ms +/- ~,2f ms  |  ~,1f MPix/s~%" (* m-mean 1000.0) (* m-std 1000.0) m-mpix)
            (format t "    SPEEDUP         : ~,2fx (~+,2f ms reduction)~%" speedup (* (- m-mean s-mean) 1000.0))
            (format t "--------------------------------------------------------------------~%")))))))

(format t "~%====================================================================~%")
(format t "        CL-JPEG FULL ENCODER END-TO-END SIMD DCT BENCHMARK          ~%")
(format t "====================================================================~%")

(let ((grad (make-test-image 2048 2048 :gradient))
      (moire (make-test-image 2048 2048 :moire)))
  (run-bench "Smooth Gradient" grad 2048 2048 :reps 20)
  (run-bench "Moiré Pattern (High Frequency)" moire 2048 2048 :reps 20))

(format t "====================================================================~%")
(sb-ext:exit)
