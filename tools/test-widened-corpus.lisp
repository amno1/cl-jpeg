(defun encode-to-byte-vector (image ncomp h w &key (sampling '((2 2)(1 1)(1 1))) (q-factor 64) q-tabs (chroma-subsampling :point))
  (let* ((tabs (or q-tabs (if (= ncomp 1) (vector jpeg::+q-luminance+) jpeg::+q-tables+)))
         (res (flexi-streams:with-output-to-sequence (s)
                (jpeg:encode-image-stream s image ncomp h w
                                          :sampling sampling
                                          :q-factor q-factor
                                          :q-tabs tabs
                                          :chroma-subsampling chroma-subsampling))))
    (coerce res '(simple-array (unsigned-byte 8) (*)))))

(defun buffer-hash (vec)
  (declare (type (simple-array (unsigned-byte 8) (*)) vec))
  (let ((hash 5381))
    (declare (type (unsigned-byte 64) hash))
    (dotimes (i (length vec) hash)
      (setf hash (logand (+ (ash hash 5) hash (aref vec i)) #xffffffffffffffff)))))

(defun test-case (name image ncomp h w &key (sampling '((2 2)(1 1)(1 1))) (q-factor 64) q-tabs expected-hash expected-len)
  (let* ((bytes (encode-to-byte-vector image ncomp h w :sampling sampling :q-factor q-factor :q-tabs q-tabs))
         (len (length bytes))
         (hash (buffer-hash bytes)))
    (if (and expected-hash expected-len)
        (let ((pass-p (and (= len expected-len) (= hash expected-hash))))
          (format t "  [~A] ~28A | len=~7D (~A), hash=#x~16,'0X (~A)~%"
                  (if pass-p "PASS" "FAIL")
                  name len (if (= len expected-len) "MATCH" "MISMATCH")
                  hash (if (= hash expected-hash) "MATCH" "MISMATCH"))
          (assert pass-p () "Test ~A failed! Expected len=~D hash=#x~X, got len=~D hash=#x~X"
                  name expected-len expected-hash len hash))
        (format t "  (\"~A\" ~D #x~16,'0X)~%" name len hash))
    (list len hash)))

;; Deterministic pseudo-random noise generator
(defun make-noise-image (w h nc &optional (seed 42))
  (let ((*random-state* (sb-ext:seed-random-state seed))
        (buf (make-array (* w h nc) :element-type '(unsigned-byte 8))))
    (dotimes (i (* w h nc))
      (setf (aref buf i) (random 256)))
    buf))

;; 1-pixel edge in flat field (stresses strip splits & clamping)
(defun make-edge-image (w h nc)
  (let ((buf (make-array (* w h nc) :element-type '(unsigned-byte 8) :initial-element 128))
        (edge-y (floor h 2))
        (edge-x (floor w 2)))
    (dotimes (x w)
      (let ((idx (* (+ (* edge-y w) x) nc)))
        (dotimes (c nc) (setf (aref buf (+ idx c)) 240))))
    (dotimes (y h)
      (let ((idx (* (+ (* y w) edge-x) nc)))
        (dotimes (c nc) (setf (aref buf (+ idx c)) 240))))
    buf))

(defun make-gradient (w h nc)
  (let ((buf (make-array (* w h nc) :element-type '(unsigned-byte 8))))
    (dotimes (y h)
      (dotimes (x w)
        (let ((idx (* (+ (* y w) x) nc)))
          (dotimes (c nc)
            (setf (aref buf (+ idx c)) (mod (+ (* x (1+ c)) (* y 3)) 256))))))
    buf))

(defun load-raw-file (path size)
  (let ((buf (make-array size :element-type '(unsigned-byte 8))))
    (with-open-file (in path :element-type '(unsigned-byte 8))
      (read-sequence buf in))
    buf))

