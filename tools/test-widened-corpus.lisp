(defun run-widened-suite (&optional golden-data)
  (format t "====================================================================~%")
  (format t "  WIDENED CL-JPEG ENCODER EQUIVALENCE TEST SUITE (37 TEST CASES)~%")
  (format t "====================================================================~%")
  (let ((results nil)
        (raw-dir "/home/arthur/repos/cl/cl-jpeg-avx512/tools/test-images/"))
    (macrolet ((run-tc (name img nc h w &rest args)
                 `(let* ((key ,name)
                         (expected (cdr (assoc key golden-data :test #'string=)))
                         (exp-len (first expected))
                         (exp-hash (second expected))
                         (res (test-case key ,img ,nc ,h ,w :expected-len exp-len :expected-hash exp-hash ,@args)))
                    (push (cons key res) results))))

      ;; 1. Noise Images (Uniform random, maximally dense AC coefficients)
      (let ((noise-rgb (make-noise-image 512 512 3 1001))
            (noise-gray (make-noise-image 512 512 1 1002)))
        (dolist (q '(25 64 95))
          (run-tc (format nil "Noise RGB 512x512 q=~D" q) noise-rgb 3 512 512 :q-factor q)
          (run-tc (format nil "Noise Gray 512x512 q=~D" q) noise-gray 1 512 512 :q-factor q)))

      ;; 2. 1-Pixel Edge in Flat Field (stresses strip splits & boundary clamping)
      (let ((edge-img (make-edge-image 512 512 3)))
        (dolist (q '(25 64 95))
          (run-tc (format nil "1-Pixel Edge 512x512 q=~D" q) edge-img 3 512 512 :q-factor q)))

      ;; 3. Photographic Images (6 real photos across multiple resolutions & odd dims)
      (let ((p1 (load-raw-file (concatenate 'string raw-dir "photo1_512x512.raw") (* 512 512 3)))
            (p2 (load-raw-file (concatenate 'string raw-dir "photo2_512x512.raw") (* 512 512 3)))
            (p3 (load-raw-file (concatenate 'string raw-dir "photo3_1024x1024.raw") (* 1024 1024 3)))
            (p4 (load-raw-file (concatenate 'string raw-dir "photo4_1024x1024.raw") (* 1024 1024 3)))
            (p5 (load-raw-file (concatenate 'string raw-dir "photo5_769x1023.raw") (* 769 1023 3)))
            (p6 (load-raw-file (concatenate 'string raw-dir "photo6_769x1023.raw") (* 769 1023 3))))
        (dolist (q '(25 64 95))
          (run-tc (format nil "Photo 1 512x512 q=~D" q) p1 3 512 512 :q-factor q)
          (run-tc (format nil "Photo 2 512x512 q=~D" q) p2 3 512 512 :q-factor q)
          (run-tc (format nil "Photo 3 1024x1024 q=~D" q) p3 3 1024 1024 :q-factor q)
          (run-tc (format nil "Photo 4 1024x1024 q=~D" q) p4 3 1024 1024 :q-factor q)
          (run-tc (format nil "Photo 5 769x1023 q=~D" q) p5 3 1023 769 :q-factor q)
          (run-tc (format nil "Photo 6 769x1023 q=~D" q) p6 3 1023 769 :q-factor q)))

      ;; 4. Legacy Gradients & Testorig (from test-encoder-equivalence.lisp)
      (run-tc "Grad 16x16 4:2:0" (make-gradient 16 16 3) 3 16 16 :sampling '((2 2)(1 1)(1 1)))
      (run-tc "Grad 16x16 4:4:4" (make-gradient 16 16 3) 3 16 16 :sampling '((1 1)(1 1)(1 1)))
      (run-tc "Grad 16x16 Gray"  (make-gradient 16 16 1) 1 16 16 :sampling '((1 1)))
      (run-tc "Grad 64x64 4:2:0" (make-gradient 64 64 3) 3 64 64 :sampling '((2 2)(1 1)(1 1)))
      (run-tc "Grad 64x64 4:2:2" (make-gradient 64 64 3) 3 64 64 :sampling '((2 1)(1 1)(1 1)))
      (run-tc "Grad 64x64 4:4:4" (make-gradient 64 64 3) 3 64 64 :sampling '((1 1)(1 1)(1 1)))
      (run-tc "Grad 100x75 4:2:0" (make-gradient 100 75 3) 3 75 100 :sampling '((2 2)(1 1)(1 1)))
      (run-tc "Grad 100x75 4:4:4" (make-gradient 100 75 3) 3 75 100 :sampling '((1 1)(1 1)(1 1)))
      (multiple-value-bind (buf h w nc)
          (let ((jpeg:*use-simd* :off))
            (jpeg:decode-image #P"/home/arthur/repos/libjpeg-turbo/testimages/testorig.jpg"))
        (run-tc "Photographic 4:2:0" buf nc h w :sampling '((2 2)(1 1)(1 1)))
        (run-tc "Photographic 4:4:4" buf nc h w :sampling '((1 1)(1 1)(1 1))))
    )
    (nreverse results)))

