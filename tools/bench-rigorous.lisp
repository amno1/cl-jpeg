(require :asdf)
(push "/home/arthur/repos/cl/cl-jpeg-avx512/" asdf:*central-registry*)
(asdf:load-system :cl-jpeg)

(in-package :cl-user)

(defun make-test-image (width height type)
  (let* ((npixels (* width height))
         (buf (make-array (* npixels 3) :element-type '(unsigned-byte 8))))
    (declare (type (simple-array (unsigned-byte 8) (*)) buf)
             (type fixnum width height npixels))
    (ecase type
      (:gradient
       (dotimes (y height)
         (dotimes (x width)
           (let ((idx (* (+ (* y width) x) 3)))
             (setf (aref buf idx) (mod x 256)
                   (aref buf (+ idx 1)) (mod y 256)
                   (aref buf (+ idx 2)) (mod (+ x y) 256))))))
      (:moire
       (dotimes (y height)
         (dotimes (x width)
           (let* ((idx (* (+ (* y width) x) 3))
                  (r (mod (+ (ash (* x x) -5) (ash (* y y) -5)) 256))
                  (g (mod (+ (* x 7) (* y 13)) 256))
                  (b (mod (logxor x y) 256)))
             (setf (aref buf idx) r
                   (aref buf (+ idx 1)) g
                   (aref buf (+ idx 2)) b))))))
    buf))

(defun measure-mode (mode image width height &key (reps 30) (warmup 5))
  (setf jpeg:*use-simd* mode)
  (let* ((npixels (* width height))
         (out-stream (make-broadcast-stream)))
    ;; Force GC and warm up
    (sb-ext:gc :full t)
    (dotimes (i warmup)
      (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1))))
    (sb-ext:gc :full t)
    (let ((times nil))
      (dotimes (r reps)
        (let ((t0 (get-internal-real-time)))
          (jpeg:encode-image-stream out-stream image 3 height width :sampling '((2 2) (1 1) (1 1)))
          (let* ((t1 (get-internal-real-time))
                 (dt (/ (- t1 t0) (float internal-time-units-per-second))))
            (push dt times))))
      (setf times (nreverse times))
      (let* ((sorted (sort (copy-list times) #'<))
             (min (first sorted))
             (max (car (last sorted)))
             (median (nth (floor reps 2) sorted))
             (mean (/ (reduce #'+ times) (length times)))
             (variance (/ (reduce #'+ (mapcar (lambda (x) (expt (- x mean) 2)) times)) (length times)))
             (std (sqrt variance))
             (mpix (/ npixels mean 1000000.0)))
        (format t "~%Mode ~6A (~D reps):~%" mode reps)
        (format t "  Individual times (ms):~%")
        (loop for t-val in times
              for i from 0 do
              (format t " ~5,1f" (* t-val 1000.0))
              (when (= (mod (1+ i) 10) 0) (terpri)))
        (format t "  Min: ~,2f ms | Median: ~,2f ms | Mean: ~,2f ms +/- ~,2f ms | Max: ~,2f ms~%"
                (* min 1000.0) (* median 1000.0) (* mean 1000.0) (* std 1000.0) (* max 1000.0))
        (format t "  Throughput: ~,1f MPix/s~%" mpix)
        (list :min min :median median :mean mean :std std :mpix mpix)))))

(format t "~%====================================================================~%")
(format t "       RIGOROUS BENCHMARK: 2048x2048 SMOOTH GRADIENT (30 reps)      ~%")
(format t "====================================================================~%")
(let* ((img (make-test-image 2048 2048 :gradient))
       (s (measure-mode :off img 2048 2048 :reps 30 :warmup 5))
       (m (measure-mode :auto img 2048 2048 :reps 30 :warmup 5)))
  (let ((speedup (/ (getf s :median) (getf m :median)))
        (diff-ms (* (- (getf s :median) (getf m :median)) 1000.0)))
    (format t "--------------------------------------------------------------------~%")
    (format t "  MEDIAN COMPARISON:~%")
    (format t "    Scalar : ~,2f ms~%" (* (getf s :median) 1000.0))
    (format t "    SIMD   : ~,2f ms~%" (* (getf m :median) 1000.0))
    (format t "    SPEEDUP: ~,2fx (~+,2f ms reduction)~%" speedup (- diff-ms))
    (format t "--------------------------------------------------------------------~%")))

(format t "~%====================================================================~%")
(format t "       RIGOROUS BENCHMARK: 2048x2048 MOIRE PATTERN (30 reps)        ~%")
(format t "====================================================================~%")
(let* ((img (make-test-image 2048 2048 :moire))
       (s (measure-mode :off img 2048 2048 :reps 30 :warmup 5))
