(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)
(in-package :jpeg)

(defun measure-allocs (path planar desc)
  (let ((*upsample-impl* (if planar #'planar-upsample nil))
        (*use-simd* :on))
    (sb-ext:gc :full t)
    (let ((c0 (sb-ext:get-bytes-consed)))
      (let ((res (decode-image path :descriptor desc)))
        (let ((c1 (sb-ext:get-bytes-consed)))
          (values (- c1 c0) (length res)))))))

(format t "~%========================================================================~%")
(format t "  MEMORY ALLOCATION DETAILED BREAKDOWN (ONE DECODE)~%")
(format t "========================================================================~%")

(dolist (item (list (list "/tmp/photo1_512x512.jpg" "photo1 512x512")
                    (list "/tmp/photo3_1024x1024.jpg" "photo3 1024x1024")))
  (let ((path (first item))
        (name (second item)))
    (format t "~%--- ~A ---~%" name)
    ;; 1. Single-shot (fresh allocation each decode)
    (multiple-value-bind (int-single-bytes out-len)
        (measure-allocs path nil nil)
      (multiple-value-bind (fus-single-bytes)
          (measure-allocs path t nil)
        (format t "Single-shot total heap allocated:~%")
        (format t "  Interleaved:  ~10D bytes (~,2F MB)~%" int-single-bytes (/ int-single-bytes 1048576.0))
        (format t "  Fused Planar: ~10D bytes (~,2F MB)~%" fus-single-bytes (/ fus-single-bytes 1048576.0))
        (format t "  Delta (diff): ~10D bytes (~,2F MB)~%"
                (- fus-single-bytes int-single-bytes)
                (/ (- fus-single-bytes int-single-bytes) 1048576.0))
        (format t "  Returned output image array: ~D bytes (~,2F MB)~%" out-len (/ out-len 1048576.0))))

    ;; 2. Reused descriptor (steady state)
    (let ((desc-int (make-descriptor))
          (desc-fus (make-descriptor)))
      ;; Warmup to populate descriptor buffers
      (measure-allocs path nil desc-int)
      (measure-allocs path t desc-fus)
      (multiple-value-bind (int-reused-bytes)
          (measure-allocs path nil desc-int)
        (multiple-value-bind (fus-reused-bytes)
            (measure-allocs path t desc-fus)
          (format t "Reused descriptor total heap allocated:~%")
          (format t "  Interleaved:  ~10D bytes (~,2F MB)~%" int-reused-bytes (/ int-reused-bytes 1048576.0))
          (format t "  Fused Planar: ~10D bytes (~,2F MB)~%" fus-reused-bytes (/ fus-reused-bytes 1048576.0))
          (format t "  Delta (diff): ~10D bytes (~,2F MB)~%"
                  (- fus-reused-bytes int-reused-bytes)
                  (/ (- fus-reused-bytes int-reused-bytes) 1048576.0)))))))
