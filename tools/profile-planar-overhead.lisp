(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(defun test-profile ()
  (let ((path "/tmp/photo3_1024x1024.jpg"))
    (format t "=== 1. Interleaved SIMD (30 iterations) ===~%")
    (let ((*use-simd* :on)
          (*upsample-impl* nil))
      (dotimes (i 5) (decode-image path))
      (sb-ext:gc :full t)
      (time (dotimes (i 30) (decode-image path))))

    (format t "~%=== 2. Planar SIMD (30 iterations) ===~%")
    (let ((*use-simd* :on)
          (*upsample-impl* #'planar-upsample))
      (dotimes (i 5) (decode-image path))
      (sb-ext:gc :full t)
      (time (dotimes (i 30) (decode-image path))))

    (format t "~%=== 3. Descriptor Reuse: Interleaved vs Planar ===~%")
    (let* ((desc-int (make-descriptor))
           (desc-pln (make-descriptor)))
      (let ((*use-simd* :on)
            (*upsample-impl* nil))
        (format t "Reused Descriptor Interleaved:~%")
        (time (dotimes (i 30)
                (decode-image path :descriptor desc-int))))
      (let ((*use-simd* :on)
            (*upsample-impl* #'planar-upsample))
        (format t "Reused Descriptor Planar:~%")
        (time (dotimes (i 30)
                (decode-image path :descriptor desc-pln)))))))

(test-profile)
