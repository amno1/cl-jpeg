(require :asdf)
(push "/home/arthur/repos/cl/cl-jpeg-avx512/" asdf:*central-registry*)
(asdf:load-system :cl-jpeg)

(in-package :jpeg)

(let* ((nblocks 8)
       (stride (* nblocks 8))
       (buf (make-array (* nblocks 64) :element-type 'sint16)))
  (dotimes (i (* nblocks 64))
    (setf (aref buf i) (- (mod (* (1+ i) 1664525) 256) 128)))
  ;; Run only Pass 1 of llm-dct:
  (let ((b_base 0) (data buf))
    (loop for r fixnum from 0 to 7
          for row_offset fixnum = (+ b_base (* r stride)) do
      (let ((d0 (+ row_offset 0)) (d1 (+ row_offset 1))
            (d2 (+ row_offset 2)) (d3 (+ row_offset 3))
            (d4 (+ row_offset 4)) (d5 (+ row_offset 5))
            (d6 (+ row_offset 6)) (d7 (+ row_offset 7)))
        (let* ((tmp0 (+ (aref data d0) (aref data d7)))
               (tmp7 (- (aref data d0) (aref data d7)))
               (tmp1 (+ (aref data d1) (aref data d6)))
               (tmp6 (- (aref data d1) (aref data d6)))
               (tmp2 (+ (aref data d2) (aref data d5)))
               (tmp5 (- (aref data d2) (aref data d5)))
               (tmp3 (+ (aref data d3) (aref data d4)))
               (tmp4 (- (aref data d3) (aref data d4)))
               (tmp10 (+ tmp0 tmp3))
               (tmp13 (- tmp0 tmp3))
               (tmp11 (+ tmp1 tmp2))
               (tmp12 (- tmp1 tmp2))
               (z1 (mul (+ tmp12 tmp13) +fix-0-541196100+))
               (z1-odd (+ tmp4 tmp7))
               (z2 (+ tmp5 tmp6))
               (z3 (+ tmp4 tmp6))
               (z4 (+ tmp5 tmp7))
               (z5 (mul (+ z3 z4) +fix-1-175875602+))
               (m4 (mul tmp4 +fix-0-298631336+))
               (m5 (mul tmp5 +fix-2-053119869+))
               (m6 (mul tmp6 +fix-3-072711026+))
               (m7 (mul tmp7 +fix-1-501321110+))
               (z1-odd-m (mul z1-odd (- +fix-0-899976223+)))
               (z2-m (mul z2 (- +fix-2-562915447+)))
               (z3-m (+ (mul z3 (- +fix-1-961570560+)) z5))
               (z4-m (+ (mul z4 (- +fix-0-390180644+)) z5)))
          (setf (aref data d0) (ash (+ tmp10 tmp11) 1))
          (setf (aref data d4) (ash (- tmp10 tmp11) 1))
          (setf (aref data d2) (descale (+ z1 (mul tmp13 +fix-0-765366865+)) +shift-1+))
          (setf (aref data d6) (descale (+ z1 (mul tmp12 (- +fix-1-847759065+))) +shift-1+))
          (setf (aref data d7) (descale (plus3 m4 z1-odd-m z3-m) +shift-1+))
          (setf (aref data d5) (descale (plus3 m5 z2-m z4-m) +shift-1+))
          (setf (aref data d3) (descale (plus3 m6 z2-m z3-m) +shift-1+))
          (setf (aref data d1) (descale (plus3 m7 z1-odd-m z4-m) +shift-1+))))))
  ;; Now print column 3:
  (format t "Pass 1 Col 3: ~a~%" (loop for r below 8 collect (aref buf (+ (* r stride) 3))))
  ;; Now run scalar Pass 2 on column 3:
  (let* ((c 3) (col_base c) (data buf)
         (d0 (+ col_base (* 0 stride))) (d1 (+ col_base (* 1 stride)))
         (d2 (+ col_base (* 2 stride))) (d3 (+ col_base (* 3 stride)))
         (d4 (+ col_base (* 4 stride))) (d5 (+ col_base (* 5 stride)))
         (d6 (+ col_base (* 6 stride))) (d7 (+ col_base (* 7 stride))))
    (let* ((tmp0 (+ (aref data d0) (aref data d7)))
           (tmp7 (- (aref data d0) (aref data d7)))
           (tmp1 (+ (aref data d1) (aref data d6)))
           (tmp6 (- (aref data d1) (aref data d6)))
           (tmp2 (+ (aref data d2) (aref data d5)))
           (tmp5 (- (aref data d2) (aref data d5)))
           (tmp3 (+ (aref data d3) (aref data d4)))
           (tmp4 (- (aref data d3) (aref data d4)))
           (z1 (+ tmp4 tmp7))
           (z2 (+ tmp5 tmp6))
           (z3 (+ tmp4 tmp6))
           (z4 (+ tmp5 tmp7))
           (z5 (mul (+ z3 z4) +fix-1-175875602+))
           (m6 (mul tmp6 +fix-3-072711026+))
           (z2-m (mul z2 (- +fix-2-562915447+)))
           (z3-m (+ (mul z3 (- +fix-1-961570560+)) z5))
           (out3 (descale (plus3 m6 z2-m z3-m) +shift+1+)))
      (format t "Calculated out3: ~d~%" out3))))
(sb-ext:exit)
