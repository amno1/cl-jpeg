(require :asdf)
(push "/home/arthur/repos/cl/cl-jpeg-avx512/" asdf:*central-registry*)
(asdf:load-system :cl-jpeg)
(require :sb-simd)

(in-package :jpeg)
(use-package :sb-simd-avx2)

(defun test-p1 ()
  (let* ((buf1 (make-array 64 :element-type 'sint16))
         (buf2 (make-array 64 :element-type 'sint16)))
    (dotimes (i 64)
      (let ((v (- (mod (* (1+ i) 1664525) 256) 128)))
        (setf (aref buf1 i) v
              (aref buf2 i) v)))

    ;; Scalar Pass 1 on Row 0:
    (let ((stride 8) (b_base 0) (data buf1))
      (loop for r fixnum from 0 to 7
            for row_offset fixnum = (+ b_base (* r stride)) do
        (let ((d0 (+ row_offset 0)) (d1 (+ row_offset 1))
              (d2 (+ row_offset 2)) (d3 (+ row_offset 3))
              (d4 (+ row_offset 4)) (d5 (+ row_offset 5))
              (d6 (+ row_offset 6)) (d7 (+ row_offset 7)))
          (let* ((tmp0 (+ (aref data d0) (aref data d7)))
                 (tmp7 (- (aref data d0) (aref data d7)))
                 (tmp1 (+ (aref data d1) (aref data d6)))
                 (tmp6 (- (aref data d1) (aref data d6)))
                 (tmp2 (+ (aref data d2) (aref data d5)))
                 (tmp5 (- (aref data d2) (aref data d5)))
                 (tmp3 (+ (aref data d3) (aref data d4)))
                 (tmp4 (- (aref data d3) (aref data d4)))
                 (tmp10 (+ tmp0 tmp3))
                 (tmp13 (- tmp0 tmp3))
                 (tmp11 (+ tmp1 tmp2))
                 (tmp12 (- tmp1 tmp2))
                 (z1 (mul (+ tmp12 tmp13) +fix-0-541196100+))
                 (z1-odd (+ tmp4 tmp7))
                 (z2 (+ tmp5 tmp6))
                 (z3 (+ tmp4 tmp6))
                 (z4 (+ tmp5 tmp7))
                 (z5 (mul (+ z3 z4) +fix-1-175875602+))
                 (m4 (mul tmp4 +fix-0-298631336+))
                 (m5 (mul tmp5 +fix-2-053119869+))
                 (m6 (mul tmp6 +fix-3-072711026+))
                 (m7 (mul tmp7 +fix-1-501321110+))
                 (z1-odd-m (mul z1-odd (- +fix-0-899976223+)))
                 (z2-m (mul z2 (- +fix-2-562915447+)))
                 (z3-m (+ (mul z3 (- +fix-1-961570560+)) z5))
                 (z4-m (+ (mul z4 (- +fix-0-390180644+)) z5)))
            (setf (aref data d0) (ash (+ tmp10 tmp11) 1))
            (setf (aref data d4) (ash (- tmp10 tmp11) 1))
            (setf (aref data d2) (descale (+ z1 (mul tmp13 +fix-0-765366865+)) +shift-1+))
            (setf (aref data d6) (descale (+ z1 (mul tmp12 (- +fix-1-847759065+))) +shift-1+))
            (setf (aref data d7) (descale (plus3 m4 z1-odd-m z3-m) +shift-1+))
            (setf (aref data d5) (descale (plus3 m5 z2-m z4-m) +shift-1+))
            (setf (aref data d3) (descale (plus3 m6 z2-m z3-m) +shift-1+))
            (setf (aref data d1) (descale (plus3 m7 z1-odd-m z4-m) +shift-1+))))))

    (format t "Scalar Pass 1 Row 0: ~a~%" (loop for c below 8 collect (aref buf1 c)))
    (format t "Scalar Pass 1 Row 1: ~a~%" (loop for c below 8 collect (aref buf1 (+ 8 c))))

    ;; SIMD Pass 1:
    (let* ((r0 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 0)))
           (r1 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 8)))
           (r2 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 16)))
           (r3 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 24)))
           (r4 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 32)))
           (r5 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 40)))
           (r6 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 48)))
           (r7 (s32.8-from-s16.8 (sb-simd-sse2:s16.8-aref buf2 56))))
      ;; Transpose rows -> cols:
      (let* ((s0 (s32.8-unpacklo r0 r1))
             (s1 (s32.8-unpackhi r0 r1))
             (s2 (s32.8-unpacklo r2 r3))
             (s3 (s32.8-unpackhi r2 r3))
             (s4 (s32.8-unpacklo r4 r5))
             (s5 (s32.8-unpackhi r4 r5))
             (s6 (s32.8-unpacklo r6 r7))
             (s7 (s32.8-unpackhi r6 r7))
             (t0 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s0) (sb-simd-avx2:s64.4! s2))))
             (t1 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s0) (sb-simd-avx2:s64.4! s2))))
             (t2 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s1) (sb-simd-avx2:s64.4! s3))))
             (t3 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s1) (sb-simd-avx2:s64.4! s3))))
             (t4 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s4) (sb-simd-avx2:s64.4! s6))))
             (t5 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s4) (sb-simd-avx2:s64.4! s6))))
             (t6 (s32.8! (sb-simd-avx2:s64.4-unpacklo (sb-simd-avx2:s64.4! s5) (sb-simd-avx2:s64.4! s7))))
             (t7 (s32.8! (sb-simd-avx2:s64.4-unpackhi (sb-simd-avx2:s64.4! s5) (sb-simd-avx2:s64.4! s7))))
             (c0 (s32.8-permute128 t0 t4 #x20))
             (c1 (s32.8-permute128 t1 t5 #x20))
             (c2 (s32.8-permute128 t2 t6 #x20))
             (c3 (s32.8-permute128 t3 t7 #x20))
             (c4 (s32.8-permute128 t0 t4 #x31))
             (c5 (s32.8-permute128 t1 t5 #x31))
             (c6 (s32.8-permute128 t2 t6 #x31))
             (c7 (s32.8-permute128 t3 t7 #x31)))
        (format t "SIMD c0 (Col 0): ~a~%" c0)
        (format t "SIMD c7 (Col 7): ~a~%" c7)
        ;; Now run 1D DCT on c0..c7:
        (let* ((tmp0 (s32.8+ c0 c7))
               (tmp7 (s32.8- c0 c7))
               (tmp1 (s32.8+ c1 c6))
               (tmp6 (s32.8- c1 c6))
               (tmp2 (s32.8+ c2 c5))
               (tmp5 (s32.8- c2 c5))
               (tmp3 (s32.8+ c3 c4))
               (tmp4 (s32.8- c3 c4))
               (tmp10 (s32.8+ tmp0 tmp3))
               (tmp13 (s32.8- tmp0 tmp3))
               (tmp11 (s32.8+ tmp1 tmp2))
               (tmp12 (s32.8- tmp1 tmp2))
               (out0 (s32.8-shiftl (s32.8+ tmp10 tmp11) 1))
               (out4 (s32.8-shiftl (s32.8- tmp10 tmp11) 1))
               (z1 (s32.8-mullo (s32.8+ tmp12 tmp13) (s32.8 4433)))
               (out2 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp13 (s32.8 6270)) (s32.8 2048)) 12))
               (out6 (s32.8-shiftr (s32.8+ z1 (s32.8-mullo tmp12 (s32.8 -15137)) (s32.8 2048)) 12))
               (z1-odd (s32.8+ tmp4 tmp7))
               (z2 (s32.8+ tmp5 tmp6))
               (z3 (s32.8+ tmp4 tmp6))
               (z4 (s32.8+ tmp5 tmp7))
               (z5 (s32.8-mullo (s32.8+ z3 z4) (s32.8 9633)))
               (m4 (s32.8-mullo tmp4 (s32.8 2446)))
               (m5 (s32.8-mullo tmp5 (s32.8 16819)))
               (m6 (s32.8-mullo tmp6 (s32.8 25172)))
               (m7 (s32.8-mullo tmp7 (s32.8 12299)))
               (z1-odd-m (s32.8-mullo z1-odd (s32.8 -7373)))
               (z2-m (s32.8-mullo z2 (s32.8 -20995)))
               (z3-m (s32.8+ (s32.8-mullo z3 (s32.8 -16069)) z5))
               (z4-m (s32.8+ (s32.8-mullo z4 (s32.8 -3196)) z5))
               (bias (s32.8 2048))
               (out7 (s32.8-shiftr (s32.8+ m4 z1-odd-m z3-m bias) 12))
               (out5 (s32.8-shiftr (s32.8+ m5 z2-m z4-m bias) 12))
               (out3 (s32.8-shiftr (s32.8+ m6 z2-m z3-m bias) 12))
               (out1 (s32.8-shiftr (s32.8+ m7 z1-odd-m z4-m bias) 12)))
          (format t "SIMD out0 (Col 0): ~a~%" out0)
          (format t "SIMD out1 (Col 1): ~a~%" out1)
          (format t "SIMD out2 (Col 2): ~a~%" out2)
          (format t "SIMD out3 (Col 3): ~a~%" out3)
          (format t "SIMD out4 (Col 4): ~a~%" out4)
          (format t "SIMD out5 (Col 5): ~a~%" out5)
          (format t "SIMD out6 (Col 6): ~a~%" out6)
          (format t "SIMD out7 (Col 7): ~a~%" out7))))))

(test-p1)
(sb-ext:exit)
