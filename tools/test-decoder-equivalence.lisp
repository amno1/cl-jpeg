(require :asdf)
(load "~/quicklisp/setup.lisp")
(asdf:load-asd "/home/arthur/repos/cl/cl-jpeg-avx512/cl-jpeg.asd")
(asdf:load-system :cl-jpeg)

(in-package :cl-user)

(defun compare-buffers (buf1 buf2 label)
  (let ((len1 (length buf1))
        (len2 (length buf2))
        (mismatches 0)
        (max-diff 0))
    (assert (= len1 len2) () "Buffer lengths differ: ~D vs ~D" len1 len2)
    (dotimes (i len1)
      (let ((diff (abs (- (aref buf1 i) (aref buf2 i)))))
        (when (> diff 0)
          (incf mismatches)
          (when (> diff max-diff)
            (setf max-diff diff)))))
    (format t "  [~A] ~A: ~D / ~D mismatches (~,2F%), max-diff=~D~%"
            (if (<= max-diff 1) "PASS" "FAIL")
            label mismatches len1 (* (/ mismatches (float len1 1.0d0)) 100.0) max-diff)
    (assert (<= max-diff 1) () "Max difference ~D exceeds 1 LSB tolerance!" max-diff)
    (values mismatches max-diff)))

(defun test-decode-image-modes (path label)
  (format t "~%=== Testing Decoder Parity for ~A (~A) ===~%" label path)
  (unless (probe-file path)
    (format t "  SKIP: ~A not found~%" path)
    (return-from test-decode-image-modes))
  
  ;; 1. Pure scalar decode (:off)
  (let ((scalar-img (let ((jpeg:*use-simd* :off))
                      (jpeg:decode-image path)))
        ;; 2. Interleaved SIMD decode (planar upsample disabled)
        (interleaved-simd-img (let ((jpeg:*use-simd* :on)
                                    (jpeg::*upsample-impl* nil))
                                (jpeg:decode-image path)))
        ;; 3. Planar SIMD decode (planar upsample + planar AVX-512 color convert)
        (planar-simd-img (let ((jpeg:*use-simd* :on)
                               (jpeg::*upsample-impl* #'jpeg::planar-upsample))
                           (jpeg:decode-image path))))
    (compare-buffers scalar-img interleaved-simd-img "Interleaved SIMD vs Scalar")
    (compare-buffers scalar-img planar-simd-img "Planar SIMD vs Scalar")
    
    ;; 4. Direct comparison: Planar SIMD vs Interleaved SIMD
    (let ((mismatches 0)
          (max-diff 0)
          (len (length planar-simd-img)))
      (dotimes (i len)
        (let ((diff (abs (- (aref planar-simd-img i) (aref interleaved-simd-img i)))))
          (when (> diff 0)
            (incf mismatches)
            (when (> diff max-diff)
              (setf max-diff diff)))))
      (format t "  [~A] Planar SIMD vs Interleaved SIMD: ~D / ~D mismatches, max-diff=~D~%"
              (if (zerop max-diff) "BIT-EXACT" (if (<= max-diff 1) "1-LSB" "FAIL"))
              mismatches len max-diff)
      (assert (<= max-diff 1) () "Planar vs Interleaved diff > 1 LSB!"))))

(defun ensure-test-fixtures ()
  (let ((raw-dir (namestring (asdf:system-relative-pathname :cl-jpeg "tools/test-images/"))))
    (unless (probe-file "/tmp/photo1_512x512.jpg")
      (let ((p1-path (concatenate 'string raw-dir "photo1_512x512.raw")))
        (when (probe-file p1-path)
          (let ((buf (make-array (* 512 512 3) :element-type '(unsigned-byte 8))))
            (with-open-file (s p1-path :element-type '(unsigned-byte 8))
              (read-sequence buf s))
            (jpeg:encode-image "/tmp/photo1_512x512.jpg" buf 3 512 512 :q-factor 64)))))
    (unless (probe-file "/tmp/photo3_1024x1024.jpg")
      (let ((p3-path (concatenate 'string raw-dir "photo3_1024x1024.raw")))
        (when (probe-file p3-path)
          (let ((buf (make-array (* 1024 1024 3) :element-type '(unsigned-byte 8))))
            (with-open-file (s p3-path :element-type '(unsigned-byte 8))
              (read-sequence buf s))
            (jpeg:encode-image "/tmp/photo3_1024x1024.jpg" buf 3 1024 1024 :q-factor 64)))))
    (unless (probe-file "/tmp/cl-jpeg-bench-512x512.jpg")
      (let ((buf (make-array (* 512 512 3) :element-type '(unsigned-byte 8))))
        (dotimes (y 512)
          (dotimes (x 512)
            (let ((idx (* (+ (* y 512) x) 3)))
              (setf (aref buf idx) (logand (+ x y) 255)
                    (aref buf (+ idx 1)) (logand (* x 2) 255)
                    (aref buf (+ idx 2)) (logand (* y 2) 255)))))
        (jpeg:encode-image "/tmp/cl-jpeg-bench-512x512.jpg" buf 3 512 512 :q-factor 64)))))

(defun run-decoder-parity-suite ()
  (ensure-test-fixtures)
  (format t "====================================================================~%")
  (format t "  CL-JPEG DECODER PLANAR SIMD PARITY SUITE~%")
  (format t "====================================================================~%")
  (test-decode-image-modes "/tmp/photo1_512x512.jpg" "photo1 512x512 (4:2:0)")
  (test-decode-image-modes "/tmp/photo3_1024x1024.jpg" "photo3 1024x1024 (4:2:0)")
  (test-decode-image-modes "/tmp/cl-jpeg-bench-512x512.jpg" "gradient 512x512")
  (test-decode-image-modes "/home/arthur/repos/libjpeg-turbo/testimages/testorig.jpg" "testorig (odd size 227x149)")
  (format t "~%====================================================================~%")
  (format t "  ALL DECODER PARITY TESTS COMPLETED SUCCESSFULLY!~%")
  (format t "====================================================================~%"))

(run-decoder-parity-suite)
