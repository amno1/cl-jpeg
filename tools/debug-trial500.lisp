(defun vref (v i)
  (nth i (multiple-value-list (sb-simd-avx2:s32.8-values v))))

(defun make-proper-block (data)
  (let ((b (make-array 8 :element-type 'sint16-array)))
    (dotimes (r 8)
      (let ((row (make-array 8 :element-type 'sint16))
            (src (nth r data)))
        (dotimes (c 8)
          (setf (aref row c) (aref src c)))
        (setf (aref b r) row)))
    b))

(defun debug-single-block ()
  (let* ((raw-data '(#(72 58 -59 74 74 -8 -85 106)
                     #(-100 -83 -1 118 -9 -67 65 -123)
                     #(97 83 -109 -21 -14 108 80 62)
                     #(115 99 -65 -100 -25 26 -58 29)
                     #(90 92 65 55 37 -37 107 43)
                     #(28 8 -117 103 109 110 91 42)
                     #(-94 41 -47 95 58 -57 14 104)
                     #(17 92 -86 48 103 -127 58 55)))
         (b-orig (make-proper-block raw-data))
         (b-simd (make-proper-block raw-data))
         (q (make-array 8 :element-type 'uint8-array :initial-contents
                        (loop repeat 8 collect (make-array 8 :element-type 'uint8 :initial-element 16))))
         (ws-orig (make-array 8 :element-type 'sint16-array :initial-contents
                              (loop repeat 8 collect (make-array 8 :element-type 'sint16 :initial-element 0))))
         (ws-simd (make-array 8 :element-type 'sint16-array :initial-contents
                              (loop repeat 8 collect (make-array 8 :element-type 'sint16 :initial-element 0)))))
    (dotimes (y 8)
      (dotimes (x 8)
        (setf (aref (aref q y) x) (+ 10 (mod (+ (* y 7) x) 80)))))

    (inverse-llm-dct b-orig q ws-orig)

    ;; Run SIMD steps manually to trace
    (let* ((b0 (aref b-simd 0)) (b1 (aref b-simd 1))
           (b2 (aref b-simd 2)) (b3 (aref b-simd 3))
           (b4 (aref b-simd 4)) (b5 (aref b-simd 5))
           (b6 (aref b-simd 6)) (b7 (aref b-simd 7))
           (r0 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b0 0)))
           (r1 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b1 0)))
           (r2 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b2 0)))
           (r3 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b3 0)))
           (r4 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b4 0)))
           (r5 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b5 0)))
           (r6 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b6 0)))
           (r7 (sb-simd-avx2:s32.8-from-s16.8 (sb-simd-avx2:s16.8-aref b7 0)))
           (d0 (sb-simd-avx2:s32.8-mullo r0 (load-q-row-s32 (aref q 0))))
           (d1 (sb-simd-avx2:s32.8-mullo r1 (load-q-row-s32 (aref q 1))))
           (d2 (sb-simd-avx2:s32.8-mullo r2 (load-q-row-s32 (aref q 2))))
           (d3 (sb-simd-avx2:s32.8-mullo r3 (load-q-row-s32 (aref q 3))))
           (d4 (sb-simd-avx2:s32.8-mullo r4 (load-q-row-s32 (aref q 4))))
           (d5 (sb-simd-avx2:s32.8-mullo r5 (load-q-row-s32 (aref q 5))))
           (d6 (sb-simd-avx2:s32.8-mullo r6 (load-q-row-s32 (aref q 6))))
           (d7 (sb-simd-avx2:s32.8-mullo r7 (load-q-row-s32 (aref q 7)))))
      (multiple-value-bind (w0 w1 w2 w3 w4 w5 w6 w7)
          (vert-idct-p1 d0 d1 d2 d3 d4 d5 d6 d7)
        (format t "w0..w7:~%")
        (format t "  w0: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w0)))
        (format t "  w1: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w1)))
        (format t "  w2: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w2)))
        (format t "  w3: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w3)))
        (format t "  w4: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w4)))
        (format t "  w5: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w5)))
        (format t "  w6: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w6)))
        (format t "  w7: ~A~%" (multiple-value-list (sb-simd-avx2:s32.8-values w7)))
        (format t "ws-orig rows:~%")
        (dotimes (i 8)
          (format t "  ws-orig ~D: ~A~%" i (aref ws-orig i)))
        (macrolet ((wrap16 (v)
                     `(sb-simd-avx2:s32.8-shiftr (sb-simd-avx2:s32.8-shiftl ,v 16) 16)))
          (setf w0 (wrap16 w0)
                w1 (wrap16 w1)
                w2 (wrap16 w2)
                w3 (wrap16 w3)
                w4 (wrap16 w4)
                w5 (wrap16 w5)
                w6 (wrap16 w6)
                w7 (wrap16 w7)))
        (multiple-value-bind (t0 t1 t2 t3 t4 t5 t6 t7)
            (transpose-8x8-s32 w0 w1 w2 w3 w4 w5 w6 w7)
          (format t "t0..t7 lane 1: (~D ~D ~D ~D ~D ~D ~D ~D)~%"
                  (vref t0 1) (vref t1 1) (vref t2 1) (vref t3 1)
                  (vref t4 1) (vref t5 1) (vref t6 1) (vref t7 1))
          (multiple-value-bind (o0 o1 o2 o3 o4 o5 o6 o7)
              (vert-idct-p2 t0 t1 t2 t3 t4 t5 t6 t7)
            (format t "o0..o7 lane 1: (~D ~D ~D ~D ~D ~D ~D ~D)~%"
                    (vref o0 1) (vref o1 1) (vref o2 1) (vref o3 1)
                    (vref o4 1) (vref o5 1) (vref o6 1) (vref o7 1))
            (multiple-value-bind (f0 f1 f2 f3 f4 f5 f6 f7)
                (transpose-8x8-s32 o0 o1 o2 o3 o4 o5 o6 o7)
              (let ((simd-rows (list f0 f1 f2 f3 f4 f5 f6 f7)))
                (dotimes (r 8)
                  (let ((s-row (multiple-value-list (sb-simd-avx2:s32.8-values (nth r simd-rows))))
                        (o-row (coerce (aref b-orig r) 'list)))
                    (format t "Row ~D: ~A  (diff: ~A)~%"
                            r
                            (if (equal s-row o-row) "MATCH" "MISMATCH")
                            (mapcar #'- s-row o-row))))))))))))

(debug-single-block)




